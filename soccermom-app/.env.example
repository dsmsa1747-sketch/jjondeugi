# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── 카카오 OAuth ──────────────────────────────────────────────
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ── 네이버 OAuth ──────────────────────────────────────────────
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── Google Cloud (서비스 계정 JSON을 base64 인코딩) ─────────────
# cat service-account-key.json | base64 -w0
GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json

# ── GCP 설정 ──────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
FIRESTORE_COLLECTION=analysisJobs

# ── Cloud Tasks + Worker ──────────────────────────────────────
CLOUD_TASKS_LOCATION=asia-northeast3
CLOUD_TASKS_QUEUE=soccermom-analyze
WORKER_URL=https://soccer-analysis-worker-xxxx-run.app
WORKER_INVOKER_SA=worker-invoker@your-project.iam.gserviceaccount.com

# ── Gemini API ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── 토스페이먼츠 ───────────────────────────────────────────────
TOSS_SECRET_KEY=test_sk_xxxx   # 라이브: live_sk_xxxx
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxx   # 라이브: live_ck_xxxx
